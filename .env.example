# Fountain of Light Prayer Ministry — environment variables
# NOTE: NEXT_PUBLIC_ prefixed vars are exposed to the browser bundle.

# Backend API (payment order create/capture endpoints)
NEXT_PUBLIC_API_URL=https://fountainoflightprayerministry.onrender.com/api

# Giving — Zelle
NEXT_PUBLIC_ZELLE_TAG=flpmi24@gmail.com

# Giving — Bank Transfer (UBA)
NEXT_PUBLIC_BANK_NAME=UBA (United Bank for Africa)
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Fountain of Light Prayer Ministry International
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=1028675968
NEXT_PUBLIC_GIVING_SUPPORT_EMAIL=flpmi24@gmail.com

# Giving — PayPal (currently disabled in src/components/give/GivingExperience.tsx)
# Get your client ID from: https://developer.paypal.com/developer/applications/
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# App Configuration
NEXT_PUBLIC_APP_NAME=Fountain of Light Prayer Ministry International
NEXT_PUBLIC_APP_URL=http://localhost:3010
