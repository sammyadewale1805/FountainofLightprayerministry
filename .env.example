# Payment Configuration
# Replace these with your actual API keys

# Paystack Configuration (for Nigerian Naira payments)
# Get your keys from: https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=pk_test_944a1bc8e5c47e6c4d01f1fc5c4d50109af17dff
VITE_PAYSTACK_SECRET_KEY=pk_test_944a1bc8e5c47e6c4d01f1fc5c4d50109af17dff

# PayPal Configuration (for USD payments)
# Get your client ID from: https://developer.paypal.com/developer/applications/
VITE_PAYPAL_CLIENT_ID=AYour_PayPal_Client_ID_Here
VITE_PAYPAL_CLIENT_SECRET=Your_PayPal_Client_Secret_Here

# Webhook Configuration (for production security)
# These are used for webhook signature verification
VITE_PAYSTACK_WEBHOOK_SECRET=whsec_your_paystack_webhook_secret
VITE_PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Security Configuration
# Set to 'true' in production for enhanced security
VITE_ENABLE_FRAUD_DETECTION=true
VITE_ENABLE_RATE_LIMITING=true
VITE_ENABLE_AUDIT_LOGGING=true

# App Configuration
VITE_APP_NAME=Fountain of Light Prayer Ministry International
VITE_APP_URL=http://localhost:5173
